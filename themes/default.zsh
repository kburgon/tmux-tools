# Green on a transparent background (the original ~/.tmux.conf look).
# Values are tmux colours: names, colourN, or #rrggbb.

accent=green         # current window, date pill, copy mode, messages
on_accent=black      # text on accent-coloured backgrounds
surface=black        # pill background for other windows, agents, session
text=white           # window names on surface
highlight=lightgreen # session name
muted=colour238      # status text while in off mode
border=green         # pane borders
border_active=yellow # active pane border, clock
busy=yellow          # Claude agent statuses
waiting=red
idle=green
remote=magenta       # host badge on remote machines
