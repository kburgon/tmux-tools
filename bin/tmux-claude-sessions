#!/usr/bin/env zsh
# Pick a running Claude Code session with fzf and jump to its tmux pane.
# Reads the session registry Claude Code keeps in ~/.claude/sessions/<pid>.json.
#
#   tmux-claude-sessions          interactive picker
#   tmux-claude-sessions --list   print the table (used by the picker's reload)

zmodload zsh/datetime

sessions_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/sessions"

# Human-readable age from a millisecond epoch timestamp.
function age {
	local secs=$(( EPOCHSECONDS - $1 / 1000 ))
	if (( secs < 60 )); then print "${secs}s"
	elif (( secs < 3600 )); then print "$(( secs / 60 ))m"
	elif (( secs < 86400 )); then print "$(( secs / 3600 ))h"
	else print "$(( secs / 86400 ))d"
	fi
}

# Print one line per session: "<pane-id>\t<aligned, colored columns>".
# The first line is the header; pane-id is "-" for sessions outside tmux.
function list {
	local f pid proc_start stat name sess_status cwd tmux_loc updated pane loc win
	local -a panes=(-) rows=("NAME	STATUS	TMUX	WINDOW	DIR	UPDATED")

	for f in "$sessions_dir"/<->.json(N); do
		IFS=$'\t' read -r pid proc_start name sess_status cwd tmux_loc updated < <(
			jq -r '[.pid, .procStart, .name, .status, .cwd, (.tmux // ""), (.statusUpdatedAt // .updatedAt)] | @tsv' "$f"
		)

		# Skip stale entries: the process is gone, or the pid was reused.
		[[ -r /proc/$pid/stat ]] || continue
		stat=$(</proc/$pid/stat)
		stat=${stat##*) }
		[[ ${${=stat}[20]} == "$proc_start" ]] || continue

		# Registry stores "session:@window.%pane"; the pane id is stable even if
		# the session or window is renamed or moved, so resolve from it.
		pane=- loc=- win=-
		if [[ -n "$tmux_loc" ]]; then
			pane=${tmux_loc##*.}
			if IFS=$'\t' read -r loc win < <(tmux display-message -p -t "$pane" '#S:#I.#P	#W' 2>/dev/null); then
				:
			else
				pane=- loc=$tmux_loc win=-
			fi
		fi

		panes+=("$pane")
		rows+=("$name	$sess_status	$loc	$win	${cwd/#$HOME/~}	$(age $updated) ago")
	done

	local -a lines=("${(@f)$(print -l -- $rows | column -t -s $'\t')}")
	local i
	for i in {1..$#lines}; do
		print -r -- "${panes[i]}	${lines[i]}"
	done | sed -e 's/\bbusy\b/\x1b[33m&\x1b[0m/' -e 's/\bidle\b/\x1b[32m&\x1b[0m/'
}

if [[ $1 == --list ]]; then
	list
	exit
fi

self=${0:A}
selected=$(
	list | fzf --ansi --reverse --header-lines=1 \
		--delimiter='\t' --with-nth=2.. \
		--prompt='claude> ' \
		--header='enter: go to pane · ctrl-r: refresh · esc: close' \
		--bind="ctrl-r:reload($self --list)" \
		--preview='[[ {1} != - ]] && tmux capture-pane -ep -t {1}' \
		--preview-window='down,50%,follow'
)

pane=${selected%%$'\t'*}
[[ -z "$pane" || "$pane" == - ]] && exit 0

if [[ -n "$TMUX" ]]; then
	tmux switch-client -t "$pane" \; select-window -t "$pane" \; select-pane -t "$pane"
else
	tmux select-window -t "$pane" \; select-pane -t "$pane" \; attach-session -t "$pane"
fi
